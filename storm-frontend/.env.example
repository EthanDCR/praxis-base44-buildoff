# Injected automatically by `npx base44 dev` during local development.
# For standalone frontend builds, set these manually.

VITE_BASE44_APP_ID=your_app_id_here
VITE_BASE44_APP_BASE_URL=https://api.base44.com

# Google Maps Platform — enable Places API + Geocoding API in Cloud Console
VITE_GOOGLE_MAPS_KEY=your_key_here
