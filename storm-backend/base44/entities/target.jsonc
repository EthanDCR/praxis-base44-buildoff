{
  "name": "Target",
  "type": "object",
  "properties": {
    "street": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation"
    },
    "zip": {
      "type": "string",
      "description": "ZIP code"
    },
    "lat": {
      "type": "number",
      "description": "Latitude"
    },
    "lng": {
      "type": "number",
      "description": "Longitude"
    },
    "business_name": {
      "type": "string",
      "description": "Business or site name"
    },
    "building_type": {
      "type": "string",
      "description": "Building type (e.g. Office, Warehouse, Retail)"
    },
    "property_type": {
      "type": "string",
      "description": "Property type (e.g. Retail, Industrial, Multifamily)"
    },
    "year_built": {
      "type": "string",
      "description": "Year the building was constructed"
    },
    "roof_type": {
      "type": "string",
      "description": "Roof type / cover material"
    },
    "roof_size_sq": {
      "type": "number",
      "description": "Roof size in squares"
    },
    "building_sqft": {
      "type": "number",
      "description": "Building square footage"
    },
    "stories": {
      "type": "number",
      "description": "Number of stories"
    },
    "hail_score_tier": {
      "type": "string",
      "enum": ["Severe", "High", "Moderate", "Low"],
      "description": "Hail risk score tier"
    },
    "hail_score_value": {
      "type": "number",
      "description": "Numeric hail risk score (0-100)"
    },
    "largest_hail_inches": {
      "type": "number",
      "description": "Largest recorded hail size in inches"
    },
    "largest_hail_date": {
      "type": "string",
      "description": "Date of the largest hail event (YYYY-MM-DD)"
    },
    "most_recent_event_date": {
      "type": "string",
      "description": "Most recent hail event date (YYYY-MM-DD)"
    },
    "total_events_10yr": {
      "type": "number",
      "description": "Total hail events in the last 10 years"
    },
    "hail_history": {
      "type": "array",
      "description": "Hail event history, newest first",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "size": { "type": "number" }
        }
      }
    },
    "data_sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Which data sources this address appeared in (e.g. DealMachine, BatchData, SalesMastery)"
    },
    "pipeline": {
      "type": "string",
      "enum": ["unassigned", "rep_queue", "overwatch", "commercial"],
      "default": "unassigned",
      "description": "Which workflow bucket this target lives in"
    },
    "status": {
      "type": "string",
      "enum": ["new", "called", "callback", "not_interested", "sold", "crm_sent"],
      "default": "new",
      "description": "Outreach progress within the pipeline"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the rep this target is assigned to"
    },
    "damage_signal": {
      "type": "string",
      "enum": ["yes", "no"],
      "description": "Damage detected by inspection API"
    },
    "notes": {
      "type": "string",
      "description": "Notes from calls or visits"
    }
  },
  "required": ["street"],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
