{
  "name": "Target",
  "type": "object",
  "properties": {
    "list_id": {
      "type": "string",
      "description": "ID of the CallList this target belongs to"
    },
    "line1": {
      "type": "string",
      "description": "Street address"
    },
    "line2": {
      "type": "string",
      "description": "City, State ZIP"
    },
    "lat": {
      "type": "number",
      "description": "Latitude"
    },
    "lng": {
      "type": "number",
      "description": "Longitude"
    },
    "hail_size": {
      "type": "number",
      "description": "Hail size in inches at this location"
    },
    "hail_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date of the hail event"
    },
    "additional_storm_dates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Additional storm event dates at this location"
    },
    "property_type": {
      "type": "string",
      "description": "Property type from Reonomy (e.g. Retail, Industrial, Multifamily)"
    },
    "property_subtype": {
      "type": "string",
      "description": "Property subtype from Reonomy"
    },
    "year_built": {
      "type": "string",
      "description": "Year the building was constructed"
    },
    "dm_property_id": {
      "type": "string",
      "description": "DealMachine property ID for this address"
    },
    "square_footage": {
      "type": "number",
      "description": "Building square footage from DealMachine"
    },
    "roof_age": {
      "type": "number",
      "description": "Roof age in years from DealMachine"
    },
    "roof_material": {
      "type": "string",
      "description": "Roof material from DealMachine"
    },
    "estimated_value": {
      "type": "number",
      "description": "Estimated property value from DealMachine"
    },
    "equity_percent": {
      "type": "number",
      "description": "Owner equity percentage from DealMachine"
    },
    "contacts": {
      "type": "array",
      "description": "Owner/contact records from DealMachine",
      "items": {
        "type": "object",
        "properties": {
          "name":    { "type": "string" },
          "company": { "type": "string" },
          "title":   { "type": "string" },
          "phones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": { "type": "string" },
                "type":   { "type": "string" }
              }
            }
          },
          "emails":  { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["new", "called", "callback", "not_interested", "sold", "overwatch", "crm_sent"],
      "default": "new",
      "description": "Current status of this target"
    },
    "phone_qualities": {
      "type": "object",
      "description": "Per-phone quality ratings keyed by contactIdx_phoneIdx"
    },
    "damage_signal": {
      "type": "string",
      "enum": ["yes", "no"],
      "description": "Damage detected by inspection API — yes or no"
    },
    "notes": {
      "type": "string",
      "description": "Notes from the call"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the rep this target is assigned to"
    }
  },
  "required": ["list_id", "line1"],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
